{
  "format": "mhm",
  "schemaVersion": 1,
  "name": "MeoW 自动签到",
  "desc": "按模块内定时脚本的时间自动完成 MeoW 猫咪签到（走 12500 签到端口）；首次打开「我的猫粮」页会自动捕获你自己的 unionId，通知会显示 uid 前缀，不含任何账号信息。换账号时会在第一个带新 unionId 的请求上立即提示「账号已更新」，并以最新 unionId 为准，旧账号的签到 URL 会被自动忽略，不会签错号。当天已签到会提示「今天已签到」并显示 uid。捕获提示只在 /checkin/checkin 上出现，60 秒内不重复。清空本地捕获：浏览器打开 https://api.chuckfang.com/__meow_reset__",
  "version": "1.5.9",
  "author": "local",
  "homepage": "",
  "icon": "https://raw.githubusercontent.com/onmiui/MITM/main/icon/meow.png",
  "updatedAt": "2026-11-21",
  "content": "#!name=MeoW 自动签到\n#!desc=按模块内定时脚本的时间自动完成 MeoW 猫咪签到；首次打开「我的猫粮」页会自动捕获你自己的 unionId，通知会显示 uid 前缀，不含任何账号信息；换号时立即提示「账号已更新」\n#!system=ios,macos\n\n[MITM]\nhostname = %APPEND% api.chuckfang.com\n\n[Script]\nMeoW_capture = type=http-request, pattern=^https?://api\\.chuckfang\\.com(?::\\d+)?/, requires-body=1, max-size=-1, timeout=10, script-path=meow.capture.js\nMeoW_checkin = type=cron, cronexp=\"30 0 * * *\", timeout=30, script-path=meow.checkin.js\n",
  "scripts": [
    {
      "name": "meow.capture.js",
      "content": "/*\n * MeoW 自动签到 - 捕获签到参数\n * 拦截 api.chuckfang.com（含 12500 端口）的请求，记下签到 URL 与 unionId。\n * unionId 变化（换账号）时覆盖旧值；旧账号的签到 URL 会被清掉，cron 以当前 uid 为准。\n * 只在 /checkin/checkin 请求上提示；60 秒内不重复提示。\n * 重置：浏览器打开 https://api.chuckfang.com/__meow_reset__ 可清空本地捕获。\n */\nvar url = String(($request && $request.url) || '');\nvar resetRe = /\\/__meow_reset__/i;\n\nfunction pad(n) { return (n < 10 ? '0' : '') + n; }\nfunction today() {\n  var d = new Date();\n  return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());\n}\n\nfunction shortUid(u) {\n  u = String(u || '');\n  if (!u) return '(空)';\n  if (u.length <= 12) return u + ' (' + u.length + '位)';\n  return u.slice(0, 8) + '…' + u.slice(-4) + ' (' + u.length + '位)';\n}\n\nif (resetRe.test(url)) {\n  // 只有确实清到东西才提示；重复打开/两个模块同时跑时，第二次保持安静。\n  var hadState = !!($persistentStore.read('MeoW.unionId') || $persistentStore.read('MeoW.checkinUrl') || $persistentStore.read('MeoW.lastOk'));\n  ['MeoW.unionId', 'MeoW.checkinUrl', 'MeoW.lastOk', 'MeoW.captureNotice', 'MeoW.noticeAt', 'MeoW.uidPending', 'MeoW.switchNoticeAt', 'MeoW.switchNoticeUid', 'MeoW.resetNoticeAt'].forEach(function (k) {\n    $persistentStore.write('', k);\n  });\n  if (hadState) {\n    try {\n      $notification.post('MeoW 自动签到', '已清空本地状态',\n        '现在运行应显示「缺少签到参数」\\n再打开猫粮页重新捕获');\n    } catch (e) {}\n  }\n  $done({});\n} else {\n  var checkinRe = /^https?:\\/\\/api\\.chuckfang\\.com(?::\\d+)?\\/checkin\\/checkin/i;\n  var isCheckin = checkinRe.test(url);\n  var m = url.match(/[?&]unionId=([^&]+)/);\n  var uid = m ? m[1] : '';\n  try { uid = decodeURIComponent(uid); } catch (e) {}\n  var changed = false;\n  var switched = false;\n\n  if (uid && isCheckin) {\n    var fixed = url.replace(/^https?:\\/\\/api\\.chuckfang\\.com(?::\\d+)?/i, 'https://api.chuckfang.com:12500');\n    if ($persistentStore.read('MeoW.checkinUrl') !== fixed) {\n      $persistentStore.write(fixed, 'MeoW.checkinUrl');\n      changed = true;\n    }\n  }\n\n  if (uid) {\n    var oldUid = $persistentStore.read('MeoW.unionId') || '';\n    if (oldUid !== uid) {\n      $persistentStore.write(uid, 'MeoW.unionId');\n      changed = true;\n      switched = !!oldUid;\n\n      // 换号：在第一个带新 unionId 的请求上立即提示一次（不是等到下次签到/cron）。\n      if (switched) {\n        var nowSwitch = Date.now();\n        var lastSwitchUid = $persistentStore.read('MeoW.switchNoticeUid') || '';\n        var lastSwitchAt = parseInt($persistentStore.read('MeoW.switchNoticeAt') || '0', 10);\n        $persistentStore.write(String(nowSwitch), 'MeoW.switchNoticeAt');\n        if (lastSwitchUid !== uid || nowSwitch - lastSwitchAt > 5000) {\n          $persistentStore.write(uid, 'MeoW.switchNoticeUid');\n          try {\n            $notification.post('MeoW 自动签到', '账号已更新',\n              'uid=' + shortUid(uid));\n          } catch (e) {}\n        }\n      }\n\n      // 旧账号的签到 URL 不能留给新账号用，否则 cron 会签错人。\n      var oldUrl = $persistentStore.read('MeoW.checkinUrl') || '';\n      var om = oldUrl.match(/[?&]unionId=([^&]+)/);\n      var oldUrlUid = om ? om[1] : '';\n      try { oldUrlUid = decodeURIComponent(oldUrlUid); } catch (e) {}\n      if (oldUrl && oldUrlUid && oldUrlUid !== uid) {\n        $persistentStore.write('', 'MeoW.checkinUrl');\n      }\n    }\n  }\n\n  if (isCheckin && uid && !switched) {\n    var now = Date.now();\n    var lastAt = parseInt($persistentStore.read('MeoW.noticeAt') || '0', 10);\n    var dailyFirst = $persistentStore.read('MeoW.captureNotice') !== today();\n\n    if ((changed || dailyFirst) && (now - lastAt > 60000)) {\n      $persistentStore.write(String(now), 'MeoW.noticeAt');\n      $persistentStore.write(today(), 'MeoW.captureNotice');\n      try {\n        $notification.post('MeoW 自动签到',\n          changed ? '已捕获签到参数' : '签到参数已就绪',\n          'uid=' + shortUid(uid) + '\\n之后按模块的定时任务自动签到');\n      } catch (e) {}\n    }\n  }\n\n  $done({});\n}\n"
    },
    {
      "name": "meow.checkin.js",
      "content": "/*\n * MeoW 自动签到 - 每日签到（cron）\n * 每天 00:30 调 12500 的签到接口；成功后当天不再重复。\n * 通知里会显示实际使用的 unionId 前缀，便于确认捕获到的是不是自己的 ID。\n * 不包含任何个人 ID：参数来自本机捕获的 MeoW.unionId / MeoW.checkinUrl。\n */\nfunction pad(n) { return (n < 10 ? '0' : '') + n; }\nfunction today() {\n  var d = new Date();\n  return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());\n}\n\nfunction uidOf(u) {\n  var m = String(u || '').match(/[?&]unionId=([^&]+)/);\n  if (!m) return '';\n  var v = m[1];\n  try { v = decodeURIComponent(v); } catch (e) {}\n  return v;\n}\n\nfunction shortUid(u) {\n  u = String(u || '');\n  if (!u) return '(空)';\n  if (u.length <= 12) return u + ' (' + u.length + '位)';\n  return u.slice(0, 8) + '…' + u.slice(-4) + ' (' + u.length + '位)';\n}\n\nfunction normalizeCheckinUrl(u) {\n  u = String(u || '').trim();\n  if (!u) return '';\n  if (/^https?:\\/\\//i.test(u)) {\n    return u.replace(/^http:\\/\\//i, 'https://')\n            .replace(/^https:\\/\\/api\\.chuckfang\\.com(?::\\d+)?/i, 'https://api.chuckfang.com:12500');\n  }\n  if (u.charAt(0) === '/') return 'https://api.chuckfang.com:12500' + u;\n  return 'https://api.chuckfang.com:12500/checkin/checkin?unionId=' + encodeURIComponent(u);\n}\n\nvar KEY_OK = 'MeoW.lastOk';\nvar t = today();\n\nif ($persistentStore.read(KEY_OK) === t) {\n  var skipFull = normalizeCheckinUrl($persistentStore.read('MeoW.checkinUrl') || '');\n  var skipUid = $persistentStore.read('MeoW.unionId') || uidOf(skipFull);\n  $notification.post('MeoW 自动签到', '今天已签到', '跳过本次\\nuid=' + shortUid(skipUid));\n  $done();\n} else {\n  var uid = $persistentStore.read('MeoW.unionId') || '';\n  var full = normalizeCheckinUrl($persistentStore.read('MeoW.checkinUrl') || '');\n  // 换号后旧 URL 可能还带旧 uid；以当前 unionId 为准，避免签错账号。\n  if (full && uid && uidOf(full) !== uid) full = '';\n  if (full && !uidOf(full)) full = '';\n  var usedUid = uid || uidOf(full);\n  var api = full;\n\n  if (!api && usedUid) {\n    api = normalizeCheckinUrl('https://api.chuckfang.com/checkin/checkin?unionId=' + encodeURIComponent(usedUid));\n  }\n\n  if (!api) {\n    $notification.post('MeoW 自动签到', '缺少签到参数',\n      '没有捕获到 unionId，请先打开一次 MeoW 的「我的猫粮」页');\n    $done();\n  } else {\n    $httpClient.get({\n      url: api,\n      headers: { 'Accept': '*/*', 'User-Agent': 'libcurl-agent/1.0' },\n      timeout: 15000\n    }, function (err, resp, data) {\n      if (err) {\n        $notification.post('MeoW 自动签到', '请求失败',\n          String(err) + '\\nuid=' + shortUid(usedUid));\n        $done();\n        return;\n      }\n\n      var obj = null;\n      try { obj = JSON.parse(data); } catch (e) {}\n      var msg = obj && obj.msg ? obj.msg : String(data || '').slice(0, 100);\n      var ok = !!(obj && obj.status === 200 && !/失败/.test(String(msg)));\n      var already = /已经签到|已签到|签到过|重复/.test(String(msg));\n      var suffix = '\\nuid=' + shortUid(usedUid);\n\n      if (ok || already) {\n        $persistentStore.write(t, KEY_OK);\n        $notification.post('MeoW 自动签到', '成功', msg + suffix);\n      } else {\n        $notification.post('MeoW 自动签到', '失败',\n          'status=' + (obj ? obj.status : '?') + ' ' + msg + suffix);\n      }\n      $done();\n    });\n  }\n}\n"
    }
  ],
  "sourceUrl": "file://local/meow-checkin.mhm"
}